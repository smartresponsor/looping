{
  "name": "smartresponsor/chatgpt-loop",
  "description": "ChatGPT consumer lifecycle loop.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "chatgpt-loop:diagnostic": "php bin/console chatgpt-loop:run --task=\"!diagnose lifecycle smoke\" --mode=diagnostic",
    "chatgpt-loop:adopt-plan": "php bin/console chatgpt-loop:adopt-current-chat --component=chatgpt-loop --location=@chatgpt-loop-plan --max-auto-iterations=1 --plan-only=1",
    "lint": "php tool/lint-php.php",
    "test": "php tool/lint-php.php && php -d zend.assertions=1 -d assert.exception=1 tool/adopt-contract-regression.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
