#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = __DIR__ . '/../vendor/autoload.php';

if (is_file($autoload)) {
    require $autoload;
} else {
    spl_autoload_register(static function (string $class): void {
        $prefix = 'App\\';

        if (!str_starts_with($class, $prefix)) {
            return;
        }

        $relative = substr($class, strlen($prefix));
        $path = __DIR__ . '/../src/' . str_replace('\\', '/', $relative) . '.php';

        if (is_file($path)) {
            require $path;
        }
    });
}

use App\Command\ChatGptLoopAdoptCurrentChatCommand;
use App\Command\ChatGptLoopRunCommand;

$command = $argv[1] ?? null;

if ($command === 'chatgpt-loop:contract') {
    fwrite(STDOUT, json_encode((new \App\Service\ChatGptLoopRunnerContract())->describe(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL);
    exit(0);
}

if ($command === 'chatgpt-loop:dispatcher-contract') {
    fwrite(STDOUT, json_encode((new \App\Service\ChatGptLoopRunnerDispatcherContract())->describe(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL);
    exit(0);
}

if ($command === 'chatgpt-loop:adopt-current-chat') {
    exit((new ChatGptLoopAdoptCurrentChatCommand(dirname(__DIR__)))->run(array_slice($argv, 2)));
}

if ($command !== 'chatgpt-loop:run') {
    fwrite(STDERR, "Available commands: chatgpt-loop:run, chatgpt-loop:adopt-current-chat, chatgpt-loop:contract, chatgpt-loop:dispatcher-contract\n");
    exit(2);
}

exit((new ChatGptLoopRunCommand(dirname(__DIR__)))->run(array_slice($argv, 2)));
