#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Command\LoopingCliCommand;
use Symfony\Component\Console\Application;

$root = dirname(__DIR__);
$autoload = $root . '/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "LOOPING_CLI_DEPENDENCIES_MISSING: run composer install before using Symfony Console.\n");
    exit(78);
}
require $autoload;

$application = new Application('Looping CLI');
$application->setAutoExit(false);
foreach (LoopingCliCommand::supportedCommands() as $name => $options) {
    $application->add(new LoopingCliCommand($name, $root, $options));
}
exit($application->run());
